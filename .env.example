# AGENSTIL ENVIRONMENT VARIABLES
# Copy to .env.local and fill in your values

# DATABASE
DATABASE_URL="postgresql://agenstil:agenstil@localhost:5432/agenstil"

# REDIS (BullMQ Queue)
REDIS_URL="redis://localhost:6379"

# NEXTAUTH
NEXTAUTH_SECRET="your-secret-key-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# AI PROVIDERS - LOCAL

# Ollama (LLM, Vision, Embeddings)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_LLM_MODEL="llama3.1:8b"
OLLAMA_VISION_MODEL="llava"
OLLAMA_EMBEDDINGS_MODEL="nomic-embed-text"

# ComfyUI (Image & Video Generation)
COMFYUI_BASE_URL="http://localhost:8188"
COMFYUI_ENABLED="true"
COMFYUI_IMAGE_MODEL="SDXL"
COMFYUI_VIDEO_MODEL="AnimateDiff"

# XTTS Voice Generation
XTTS_MODEL_PATH="./models/xtts"
XTTS_DEVICE="cpu"  # or cuda if GPU available
XTTS_ENABLED="true"

# Whisper STT
WHISPER_MODEL="base"  # tiny, base, small, medium
WHISPER_DEVICE="cpu"  # or cuda
WHISPER_ENABLED="true"

# AI PROVIDERS - CLOUD FREE FALLBACK

# Groq (Free LLM + Vision + STT)
GROQ_API_KEY=""
GROQ_ENABLED="true"
GROQ_TEXT_MODEL="mixtral-8x7b-32768"
GROQ_VISION_MODEL="llama-2-90b-vision"
GROQ_STT_MODEL="whisper-large-v3"

# Tensor.Art (Free Image/Video)
TENSOR_ART_API_KEY=""
TENSOR_ART_ENABLED="false"
TENSOR_ART_BASE_URL="https://api.tensor.art/v1"

# STORAGE
STORAGE_TYPE="local"  # local or supabase
STORAGE_PATH="./uploads"

# Supabase (Optional S3-compatible storage)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_KEY=""

# BROWSER AUTOMATION
PLAYWRIGHT_BROWSER="chromium"  # chromium, firefox, webkit

# LOGGING
LOG_LEVEL="info"  # debug, info, warn, error
DEBUG="agenstil:*"

# FEATURE FLAGS
ENABLE_LIVE_WATCHER="true"
ENABLE_AVATAR_SYSTEM="true"
ENABLE_VIDEO_MERGE="true"
WATCHER_POLL_INTERVAL_HOURS="24"

# APPLICATION
NODE_ENV="development"  # development, production
PORT="3000"
HOST="0.0.0.0"

# JOB QUEUE
BULLMQ_WORKER_CONCURRENCY="2"
BULLMQ_WORKER_TIMEOUT="3600000"  # 1 hour
BULLMQ_MAX_ATTEMPTS="3"
